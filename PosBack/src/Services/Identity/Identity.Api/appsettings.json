{
  "ConnectionStrings": {
    "IdentityDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=GroceryPOS_Identity;TrustServerCertificate=True;Encrypt=True"
  },
  "Jwt": {
    "Issuer": "GroceryPOS.Identity",
    "Audience": "GroceryPOS.Api",
    "SigningKey": "development-only-signing-key-change-before-production"
  },
  "JsonPersistence": {
    "FileName": "users.json",
    "DataPath": "data/identity",
    "SeedInDevelopment": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
