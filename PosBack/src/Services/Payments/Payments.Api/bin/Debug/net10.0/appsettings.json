{
  "Jwt": {
    "Issuer": "GroceryPOS.Identity",
    "Audience": "GroceryPOS.Api",
    "SigningKey": "development-only-signing-key-change-before-production"
  },
  "JsonPersistence": {
    "FileName": "payments.json",
    "DataPath": "data/payments",
    "SeedInDevelopment": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
