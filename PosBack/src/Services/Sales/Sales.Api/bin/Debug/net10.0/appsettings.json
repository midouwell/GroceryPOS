{
  "Jwt": {
    "Issuer": "GroceryPOS.Identity",
    "Audience": "GroceryPOS.Api",
    "SigningKey": "development-only-signing-key-change-before-production"
  },
  "JsonPersistence": {
    "FileName": "sales.json",
    "DataPath": "data/sales",
    "SeedInDevelopment": true
  },
  "Services": {
    "Products": "http://localhost:5102/",
    "Inventory": "http://localhost:5103/",
    "Payments": "http://localhost:5105/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
