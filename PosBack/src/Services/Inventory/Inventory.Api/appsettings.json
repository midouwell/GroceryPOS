{
  "ConnectionStrings": {
    "InventoryDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=GroceryPOS_Inventory;TrustServerCertificate=True;Encrypt=True"
  },
  "Jwt": {
    "Issuer": "GroceryPOS.Identity",
    "Audience": "GroceryPOS.Api",
    "SigningKey": "development-only-signing-key-change-before-production"
  },
  "JsonPersistence": {
    "Stock": { "FileName": "stock.json", "DataPath": "data/inventory", "SeedInDevelopment": true },
    "Movements": { "FileName": "movements.json", "DataPath": "data/inventory", "SeedInDevelopment": true }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
