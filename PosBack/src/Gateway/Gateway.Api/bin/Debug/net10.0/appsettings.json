{
  "Jwt": {
    "Issuer": "GroceryPOS.Identity",
    "Audience": "GroceryPOS.Api",
    "SigningKey": "development-only-signing-key-change-before-production"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": { "ClusterId": "identity", "Match": { "Path": "/api/v1/auth/{**catch-all}" } },
      "identity-users": { "ClusterId": "identity", "Match": { "Path": "/api/v1/users/{**catch-all}" } },
      "products": { "ClusterId": "products", "Match": { "Path": "/api/v1/products/{**catch-all}" } },
      "inventory": { "ClusterId": "inventory", "Match": { "Path": "/api/v1/inventory/{**catch-all}" } },
      "sales": { "ClusterId": "sales", "Match": { "Path": "/api/v1/sales/{**catch-all}" } },
      "payments": { "ClusterId": "payments", "Match": { "Path": "/api/v1/payments/{**catch-all}" } },
      "customers": { "ClusterId": "customers", "Match": { "Path": "/api/v1/customers/{**catch-all}" } },
      "reports": { "ClusterId": "reports", "Match": { "Path": "/api/v1/reports/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "identity": { "Address": "http://localhost:5101/" } } },
      "products": { "Destinations": { "products": { "Address": "http://localhost:5102/" } } },
      "inventory": { "Destinations": { "inventory": { "Address": "http://localhost:5103/" } } },
      "sales": { "Destinations": { "sales": { "Address": "http://localhost:5104/" } } },
      "payments": { "Destinations": { "payments": { "Address": "http://localhost:5105/" } } },
      "customers": { "Destinations": { "customers": { "Address": "http://localhost:5106/" } } },
      "reports": { "Destinations": { "reports": { "Address": "http://localhost:5107/" } } }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
